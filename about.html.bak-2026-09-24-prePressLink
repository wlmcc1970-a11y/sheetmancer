<style>
  :root{
    --bg:#0b0806; --bg2:#120d0a; --surface:#191210; --surface2:#241a12;
    --line:rgba(212,168,67,.20); --line2:rgba(212,168,67,.42);
    --gold:#D4A843; --gold2:#C4832A; --goldlite:#F3D07A; --cream:#F4EAD4; --body:#CFC1A1; --muted:#9c8e75; --ink:#160d05;
    --disp:'Cormorant Garamond',Georgia,serif; --label:'Cinzel',Georgia,serif; --voice:'EB Garamond',Georgia,serif;
    --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    --wrap:1080px;
  }
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--body);font-family:var(--sans);line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
  img{max-width:100%;display:block}
  a{color:var(--gold)}
  .wrap{max-width:var(--wrap);margin:0 auto;padding:0 22px}
  section{position:relative}
  .kick{font-family:var(--label);font-weight:600;font-size:12px;letter-spacing:.34em;text-transform:uppercase;color:var(--gold);margin:0 0 14px}
  h2{font-family:var(--disp);font-weight:700;color:var(--cream);font-size:clamp(28px,4.4vw,44px);line-height:1.08;margin:0 0 10px;letter-spacing:.5px}
  .lede{font-family:var(--voice);font-style:italic;font-size:clamp(17px,2.2vw,21px);color:var(--goldlite);margin:0 0 6px}
  p{font-size:16px}

  /* HERO */
  .hero{padding:56px 0 20px;text-align:center;background:
      radial-gradient(120% 90% at 50% -10%, #241a12 0%, #150f0b 42%, var(--bg) 78%);
      border-bottom:1px solid var(--line)}
  .appicon{width:84px;height:84px;border-radius:20px;margin:0 auto 16px;box-shadow:0 0 0 1px rgba(243,208,122,.35),0 14px 44px rgba(0,0,0,.6),0 0 60px rgba(212,168,67,.25)}
  .brand{font-family:var(--disp);font-weight:700;font-size:26px;letter-spacing:1px;margin:0}
  .brand .a{color:var(--cream)} .brand .b{color:var(--gold);text-shadow:0 0 22px rgba(243,208,122,.4)}
  .subtag{font-family:var(--label);font-size:11px;letter-spacing:.32em;color:var(--gold2);margin:8px 0 26px}
  .hero h1{font-family:var(--disp);font-weight:700;color:var(--cream);font-size:clamp(40px,8vw,74px);line-height:1;margin:0 0 18px;letter-spacing:.5px}
  .hero h1 .g{color:var(--gold);text-shadow:0 0 30px rgba(243,208,122,.35)}
  .hero-sub{max-width:660px;margin:0 auto 30px;font-size:clamp(16px,2.1vw,19px);color:var(--body)}
  .hero-sub b{color:var(--cream);font-weight:600}
  .trust{font-family:var(--label);font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);margin:22px 0 0}
  .trust b{color:var(--gold)}

  /* store buttons */
  .cta{display:flex;gap:14px;flex-wrap:wrap;justify-content:center}
  .sbtn{display:inline-flex;align-items:center;gap:11px;background:#000;color:#fff;text-decoration:none;border-radius:12px;padding:11px 20px 11px 16px;border:1px solid rgba(243,208,122,.4);transition:transform .15s ease,box-shadow .2s ease,border-color .2s}
  .sbtn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(0,0,0,.5),0 0 24px rgba(212,168,67,.3);border-color:var(--gold)}
  .sbtn .txt{display:flex;flex-direction:column;line-height:1.12;text-align:left;font-family:var(--sans)}
  .sbtn .txt small{font-size:11px;opacity:.92}
  .sbtn .txt b{font-size:20px;font-weight:600}

  /* feature-graphic banner */
  .banner{padding:34px 0 4px}
  .banner .frame{max-width:940px;margin:0 auto;border-radius:16px;overflow:hidden;border:1px solid var(--line2);box-shadow:0 24px 70px rgba(0,0,0,.55)}

  /* generic section spacing */
  .band{padding:64px 0}
  .band.center{text-align:center}
  .head{max-width:660px;margin:0 auto 34px;text-align:center}

  /* feature checklist buttons */
  .featgrid{display:flex;flex-wrap:wrap;justify-content:center;gap:12px;margin:0 0 30px}
  .feat{width:calc((100% - 24px)/3);display:flex;align-items:flex-start;gap:11px;background:linear-gradient(180deg,var(--surface2),var(--surface));border:1px solid var(--line);border-radius:12px;padding:15px 16px;transition:transform .16s ease,border-color .2s,box-shadow .2s}
  .feat:hover{transform:translateY(-3px);border-color:var(--line2);box-shadow:0 14px 34px rgba(0,0,0,.42)}
  .feat .ck{flex:0 0 auto;width:22px;height:22px;color:var(--gold);margin-top:2px}
  .feat .lbl b{display:block;font-family:var(--disp);font-weight:700;color:var(--cream);font-size:18.5px;letter-spacing:.2px;line-height:1.16}
  .feat .lbl span{display:block;font-size:12.5px;color:var(--muted);margin-top:3px;line-height:1.42}

  /* closing pricing detail + cta */
  .pricebox{text-align:center}
  .terms{max-width:600px;margin:6px auto 24px;font-size:13.5px;color:var(--muted);line-height:1.55}

  /* footer */
  footer{border-top:1px solid var(--line);padding:34px 0 40px;text-align:center;color:var(--muted);font-size:13px}
  .fbrand{font-family:var(--disp);font-weight:700;color:var(--cream);font-size:20px;letter-spacing:.5px}
  .ftag{font-family:var(--voice);font-style:italic;color:var(--gold2);font-size:14px;margin:2px 0 14px}
  .flinks a{color:var(--body);text-decoration:none;margin:0 9px;font-size:13px}
  .flinks a:hover{color:var(--gold)}
  .social{margin:14px 0 10px}
  .social a{color:var(--gold);text-decoration:none;font-family:var(--label);font-size:11px;letter-spacing:.14em;text-transform:uppercase;margin:0 8px}
  .divider{width:64px;height:1px;background:linear-gradient(90deg,transparent,var(--gold2),transparent);margin:14px auto}

  /* screenshot gallery + lightbox */
  .gallery{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
  .gallery button{padding:0;border:0;background:none;cursor:zoom-in;border-radius:14px;overflow:hidden;line-height:0;display:block}
  .gallery img{width:100%;height:auto;border-radius:14px;border:1px solid var(--line);box-shadow:0 14px 40px rgba(0,0,0,.5);transition:transform .25s ease,box-shadow .25s ease,border-color .2s}
  .gallery button:hover img,.gallery button:focus-visible img{transform:scale(1.03);border-color:var(--line2);box-shadow:0 20px 52px rgba(0,0,0,.6),0 0 30px rgba(212,168,67,.2)}
  .lb{position:fixed;inset:0;background:rgba(7,5,3,.93);display:none;align-items:center;justify-content:center;z-index:200;padding:24px}
  .lb.open{display:flex}
  .lb img{max-width:96vw;max-height:92vh;width:auto;height:auto;border-radius:12px;border:1px solid var(--line2);box-shadow:0 30px 90px rgba(0,0,0,.75)}
  .lb .x,.lb .nav{position:absolute;background:rgba(26,19,14,.9);border:1px solid var(--line2);color:var(--gold);cursor:pointer;display:flex;align-items:center;justify-content:center;user-select:none;line-height:1}
  .lb .x{top:16px;right:18px;width:44px;height:44px;border-radius:50%;font-size:26px}
  .lb .nav{top:50%;transform:translateY(-50%);width:48px;height:48px;border-radius:50%;font-size:30px}
  .lb .prev{left:16px} .lb .next{right:16px}
  .lb .x:hover,.lb .nav:hover{border-color:var(--gold);background:rgba(42,30,20,.96)}

  /* demo video */
  .demo{max-width:-moz-fit-content;max-width:fit-content;margin:0 auto;background:#000;border:1px solid var(--line2);border-radius:22px;overflow:hidden;box-shadow:0 26px 70px rgba(0,0,0,.6),0 0 60px rgba(212,168,67,.12)}
  .demo video{display:block;max-width:100%;max-height:640px;width:auto;height:auto}

  /* reveal */
  .reveal{opacity:0;transform:translateY(20px);transition:opacity .7s ease,transform .7s ease}
  .reveal.in{opacity:1;transform:none}

  @media(max-width:820px){ .feat{width:calc((100% - 12px)/2)} .gallery{grid-template-columns:repeat(2,1fr)} }
  @media(max-width:520px){
    .feat{width:100%}
    .hero{padding:44px 0 12px}
    .band{padding:48px 0}
    .sbtn{padding:10px 18px 10px 14px}
  }
  .scrollcue{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:150;display:flex;flex-direction:column;align-items:center;gap:4px;padding:0;border:0;background:none;color:var(--gold);cursor:pointer;opacity:.82;transition:opacity .45s ease;font-family:var(--label);font-size:9px;letter-spacing:.24em;text-transform:uppercase}
  .scrollcue.hide{opacity:0;pointer-events:none}
  .scrollcue .chev{width:32px;height:32px;border:1px solid var(--line2);border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(11,8,6,.6);box-shadow:0 4px 16px rgba(0,0,0,.4);animation:cuebob 1.9s ease-in-out infinite}
  .scrollcue:hover .chev{border-color:var(--gold);background:rgba(30,21,14,.85)}
  @keyframes cuebob{0%,100%{transform:translateY(0)}50%{transform:translateY(6px)}}
  @media(prefers-reduced-motion:reduce){.scrollcue .chev{animation:none}}
</style>
<noscript><style>.reveal{opacity:1;transform:none}</style></noscript>
</head>
